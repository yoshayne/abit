# Copy this file to .env.local for local dev.
# On Railway, DATABASE_URL and REDIS_URL are provided automatically
# when you add the Postgres and Redis plugins — you do NOT set them by hand.

# Postgres (Railway provides this automatically)
DATABASE_URL=

# Set to "true" ONLY if connecting over Postgres public URL (needs SSL)
DATABASE_SSL=

# Redis (Railway provides this automatically)
REDIS_URL=

# Brevo — required for form-submission notification emails (M4).
# Without these two set, forms still save to Postgres, but no one gets
# emailed. Get BREVO_API_KEY from Brevo → SMTP & API → API Keys.
BREVO_API_KEY=
ABIT_NOTIFY_EMAIL=abitcommunity1@gmail.com

# Railway storage bucket (Tigris, S3-compatible) — already set on Railway.
# Needed for event/news image uploads (lib/storage.ts).
BUCKET_ENDPOINT_URL=
BUCKET_NAME=
BUCKET_REGION=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=

# Admin login (M5). Signs admin session cookies — required for /admin to
# work at all. Generate a random 32+ byte value once and never change it
# without expecting every admin to be logged out.
# e.g. `openssl rand -base64 32`
ADMIN_JWT_SECRET=
