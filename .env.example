# Copy this file to .env.local for local dev.
# On Railway, DATABASE_URL and REDIS_URL are provided automatically
# when you add the Postgres and Redis plugins — you do NOT set them by hand.

# Postgres (Railway provides this automatically)
DATABASE_URL=

# Set to "true" ONLY if connecting over Postgres public URL (needs SSL)
DATABASE_SSL=

# Redis (Railway provides this automatically)
REDIS_URL=

# --- Added in later milestones ---
# BREVO_API_KEY=
# ABIT_NOTIFY_EMAIL=abitcommunity@gmail.com
# ADMIN_JWT_SECRET=
