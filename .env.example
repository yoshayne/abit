# Copy this file to .env.local for local dev.
# On Railway, DATABASE_URL and REDIS_URL are provided automatically
# when you add the Postgres and Redis plugins — you do NOT set them by hand.

# Postgres (Railway provides this automatically)
DATABASE_URL=

# Set to "true" ONLY if connecting over Postgres public URL (needs SSL)
DATABASE_SSL=

# Redis (Railway provides this automatically)
REDIS_URL=

# Brevo — required for form-submission notification/confirmation emails
# (M4/M7) and newsletter list sync (M7). Without BREVO_API_KEY and
# BREVO_SENDER_EMAIL set, forms still save to Postgres, but no one gets
# emailed and newsletter signups don't reach a Brevo list.
# Get BREVO_API_KEY from Brevo → SMTP & API → API Keys.
BREVO_API_KEY=

# The "From" address on every outgoing email (admin notifications AND
# submitter confirmations). Must be verified as a sender in Brevo
# (Senders, Domains & Dedicated IPs → Senders) or Brevo will reject every
# send. This can be a different inbox than ABIT_NOTIFY_EMAIL below — useful
# for testing with a personal verified address before Cierra's domain
# (and a matching @domain sender) is set up.
BREVO_SENDER_EMAIL=abitcommunity1@gmail.com

# Where admin-facing notification emails (new mentor application, new
# enrollment, etc.) get delivered. Just a delivery address — does NOT need
# to be verified with Brevo, and can be any inbox regardless of
# BREVO_SENDER_EMAIL above.
ABIT_NOTIFY_EMAIL=abitcommunity1@gmail.com

# Leave unset in production — only for pointing lib/email.ts at a local mock
# Brevo server during testing. Defaults to https://api.brevo.com/v3.
BREVO_API_BASE=

# Railway storage bucket (Tigris, S3-compatible) — already set on Railway.
# Needed for event/news image uploads (lib/storage.ts).
BUCKET_ENDPOINT_URL=
BUCKET_NAME=
BUCKET_REGION=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=

# Admin login (M5). Signs admin session cookies — required for /admin to
# work at all. Generate a random 32+ byte value once and never change it
# without expecting every admin to be logged out.
# e.g. `openssl rand -base64 32`
ADMIN_JWT_SECRET=
